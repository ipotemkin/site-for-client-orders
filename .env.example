# Copy to .env and fill in real values:
#   cp .env.example .env

# ---------- Nginx ----------
NGINX_HTTP_PORT=80

# ---------- PostgreSQL ----------
# Not published outside Docker. Access only from
# Backend (and pgAdmin) on the internal network.
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=app_db

# ---------- pgAdmin ----------
# Open via Nginx: http://<server>/pgadmin/
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_pgadmin_password

# ---------- Docker Registry ----------
# External access for docker push/pull from local machines.
# docker login <REGISTRY_HOST>:<REGISTRY_PORT>
REGISTRY_HOST=your.server.example.com
REGISTRY_PORT=5000
REGISTRY_USER=deploy
REGISTRY_PASSWORD=change_me_strong_registry_password

# ---------- Watchtower ----------
# How often to check for new images (seconds)
WATCHTOWER_POLL_INTERVAL=300

# ---------- Backend (when enabled) ----------
# BACKEND_TAG=latest
# Image will be:
#   ${REGISTRY_HOST}:${REGISTRY_PORT}/backend:${BACKEND_TAG}
